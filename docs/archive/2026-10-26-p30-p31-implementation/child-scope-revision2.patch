+            {:DOWN, ^peer_ref, :process, _, _} ->
+              :ok
+
+            {:DOWN, ^root_ref, :process, _, _} ->
+              :ok
+          end
+        end)
+
+      remaining = max(deadline - System.monotonic_time(:millisecond), 0)
+
+      tracked =
+        if remaining > 0 do
+          try do
+            GenServer.call(root, {:track_child_effect, peer, token}, min(remaining, 5_000))
+          catch
+            :exit, _ -> :unconfirmed
+          end
+        else
+          :unconfirmed
