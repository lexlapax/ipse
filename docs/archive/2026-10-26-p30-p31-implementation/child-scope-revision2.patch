+    token = make_ref()
+    deadline = System.monotonic_time(:millisecond) + timeout
+
+    if is_pid(root) and active?(min(timeout, 5_000)) do
+      if hook = Process.get({__MODULE__, :private_diagnostic_hook}), do: hook.()
+
+      {peer, monitor} =
