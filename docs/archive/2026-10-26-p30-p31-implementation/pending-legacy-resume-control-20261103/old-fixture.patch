+  @tag :registered_capture_sequence
+  @tag :pending_historical_resume_control
+  @tag metadata_version: 3, registered_main: true, capture_write: true,
+       registered_capture_modes: ["capture", "legacy_first_pending"], timeout: 120_000
+  test "historical pending model result refuses or withdraws on a current-runtime resume", c do
+    capture = start(c)
+    source_id = Session.info(capture).id
+    assert :ok = Session.prompt(capture, "Synthetic café observation")
+    assert_receive {:ipse, ^capture, {:done, :ok}}, 30_000
+    assert :ok = Session.close_confirmed(capture)
+
+    reader = start(c)
+    reader_id = Session.info(reader).id
+    assert reader_id != source_id
+    assert :ok = Session.prompt(reader, "Read the pending synthetic candidate.")
+    assert_receive {:ipse, ^reader, {:done, :ok}}, 30_000
+    assert {:ok, events} = Journal.load(c.dir, reader_id)
+    assert [get] = Enum.filter(events, fn event ->
+      event["type"] == "extension_action_result" and get_in(event, ["request", "request", "op"]) == "get" and
+        get_in(event, ["outcome", "value", "record", "value", "text"]) == "Synthetic café observation"
+    end)
+    assert [get_read] = Enum.filter(events, fn event ->
+      event["type"] == "managed_read_observed" and event["operation_id"] == get["operation_id"]
+    end)
+    assert [%{"version" => 3}] = get_read["dependencies"]
+    assert get_read["result_sha256"] == JSON.digest([get["outcome"]["value"]])
+    assert Enum.any?(events, fn event ->
+      event["type"] == "message" and get_in(event, ["message", "role"]) == "tool" and
+        String.contains?(get_in(event, ["message", "content"]) || "", "Synthetic café observation")
+    end)
+    assert {:ok, _} = Session.Saved.restore(events, reader_id)
+    assert :ok = Session.close_confirmed(reader)
+    requests = Task.await(c.provider_server, 10_000)
+    assert length(requests) == 4
+    assert Enum.any?(requests, fn {_, body} ->
+      Enum.any?(body["messages"] || [], fn message ->
+        message["role"] == "tool" and String.contains?(message["content"] || "", "Synthetic café observation")
+      end)
+    end)
+
+    fixture = Path.join(c.root, "current-resume.term")
+    File.write!(fixture, :erlang.term_to_binary(%{config: c.config, selected: c.selected,
+      cwd: c.cwd, dir: c.dir, home: c.home, reader_id: reader_id, source_id: source_id}))
+    File.chmod!(fixture, 0o600)
+    source = Path.join(c.dir, source_id <> ".jsonl")
+    lock = Path.join(c.dir, source_id <> ".lock")
+    held = source <> ".legacy-replay-held"
+    before = File.stat!(source)
+    lock_before = File.stat!(lock)
+    digest = JSON.sha256(File.read!(source))
+    refute File.exists?(held)
+    File.rename!(source, held)
+
+    try do
+      current = System.fetch_env!("IPSE_PENDING_REPLAY_CURRENT")
+      paths = Path.wildcard(Path.join(current, "_build/test/lib/*/ebin")) |> Enum.flat_map(&["-pa", &1])
+      {output, status} = System.cmd(System.find_executable("elixir"),
+        ["--erl", "+S 2:2"] ++ paths ++ [Path.join(current, "test/support/pending_legacy_resume.exs"), fixture],
+        stderr_to_stdout: true)
+      File.write!(Path.join(c.root, "current-resume.log"), output)
+      assert status == 0, output
+      assert output =~ "LEGACY_RESUME_CONTROL_PASSED"
+    after
+      if File.exists?(held) and not File.exists?(source), do: File.rename!(held, source)
+      restored = File.stat!(source)
+      lock_after = File.stat!(lock)
+      assert {restored.major_device, restored.inode} == {before.major_device, before.inode}
+      assert {lock_after.major_device, lock_after.inode} == {lock_before.major_device, lock_before.inode}
+      assert JSON.sha256(File.read!(source)) == digest
+    end
+  end
+
