+  defp await(pid, allow, count, deadline) do
+    receive do
+      {:ipse, ^pid, {:approval, ref, "extension:state.put", proposed}} ->
+        assert :ok = Ipse.Extension.State.validate(proposed["request"])
+        assert proposed["request"]["scope"] == "project"
