+      |> Map.put("source_id", Store.provided_transfer_id(text))
+      |> put_in(["provided_transfer", "body_sha256"], Evidence.sha256(text))
+      |> put_in(["provided_transfer", "quote"], "repeat")
+      |> put_in(["provided_transfer", "start_byte"], 0)
