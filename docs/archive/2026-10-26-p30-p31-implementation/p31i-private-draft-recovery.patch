diff --git a/lib/ipse/session/draft.ex b/lib/ipse/session/draft.ex
index 7732e35..fa9519c 100644
--- a/lib/ipse/session/draft.ex
+++ b/lib/ipse/session/draft.ex
@@ -137,6 +137,13 @@ defmodule Ipse.Session.Draft do
   def project(%{status: :cancelled, notice: true} = d, messages) when is_list(messages),
     do: withdraw(d, messages, :cancelled)
 
+  def project(%{status: :cancelled, notice: false} = d, messages) when is_list(messages) do
+    case withdraw(d, messages, :incomplete) do
+      {:ok, _} -> {:ok, messages}
+      error -> error
+    end
+  end
+
   def project(%{status: :consumed, accepted_message: true} = d, messages) when is_list(messages),
     do: withdraw(d, messages, :accepted)
 
