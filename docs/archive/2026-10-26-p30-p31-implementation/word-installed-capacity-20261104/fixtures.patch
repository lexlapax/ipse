+defmodule InstalledWordCapacityJourney do
+  import ExUnit.Assertions
+  alias Ipse.{JSON, Journal, Session}
+  @source "workspace:capacity"
+  @filename "capacity.docx"
+
+  def run(options, cwd, home, digest, partition) do
+    assert is_binary(partition) and partition != ""
+    fixture = Ipse.Test.WordCapacityFixture.build(:at_bound)
+    assert fixture.original_bytes === 1_048_576 and fixture.text_bytes === 65_536
+    assert fixture.chunks === 32
+    file = Path.join(cwd, @filename)
+    File.write!(file, fixture.bytes)
+    assert {:ok, pid} = DynamicSupervisor.start_child(Ipse.Sessions, {Session, options})
+    id = Session.info(pid).id
+    invoke = fn pid, command, args -> DocumentSetupJourney.invoke(pid, command, args, digest) end
+    acquire = arguments(1, 0, JSON.sha256(fixture.bytes))
+    value = invoke.(pid, "source", acquire)
+    value = DocumentSetupJourney.finish(pid, value, digest)
+    assert value["status"] === "ok", inspect(value)
+    head = head(home, cwd, partition)
+    assert head["value"]["text_bytes"] === fixture.text_bytes
+    assert head["value"]["chunks"] === 32
+    assert get_in(head, ["value", "lexical", "content_sha256"]) === JSON.sha256(fixture.text)
+    citations = citations(pid, fixture, digest)
+    File.write!(file, DocumentSetupJourney.document())
+    refused(pid, "firstcapacityneedle", digest)
+    assert head(home, cwd, partition) === head
+    File.write!(file, fixture.bytes)
+    assert citations(pid, fixture, digest) === citations
+    held = file <> ".held"
+    refute File.exists?(held)
+    assert :ok = File.rename(file, held)
+    refused(pid, "middlecapacityneedle", digest)
+    {before_close, _} = events(options[:state_dir], id)
+    original_acquisitions = acquisitions(before_close)
+    assert length(original_acquisitions) === 1
+    assert :ok = Session.close_confirmed(pid)
+    assert {:ok, before_reopen} = Journal.load(options[:state_dir], id)
+
+    assert {:ok, resumed} =
+             DynamicSupervisor.start_child(
+               Ipse.Sessions,
+               {Session, Keyword.put(options, :id, id)}
+             )
+
+    assert Session.info(resumed).phase === :idle
+    assert {:ok, after_reopen} = Journal.load(options[:state_dir], id)
+    assert intents(after_reopen) === intents(before_reopen)
+    refused(resumed, "lastcapacityneedle", digest)
+    assert :ok = File.rename(held, file)
+    assert citations(resumed, fixture, digest) === citations
+    assert head(home, cwd, partition) === head
+    assert {:ok, after_restore} = Journal.load(options[:state_dir], id)
+    assert acquisitions(after_restore) === original_acquisitions
+
+    refusals =
+      for kind <- [:text_over, :original_over, :chunk_over] do
+        over = Ipse.Test.WordCapacityFixture.build(kind)
+
+        expected_text_bytes =
+          case kind do
+            :text_over -> 65_537
+            :chunk_over -> 35_872
+            :original_over -> 65_536
+          end
+
+        assert over.text_bytes === expected_text_bytes
+
+        assert over.original_bytes === if(kind === :original_over, do: 1_048_577, else: 1_048_576)
+        File.write!(file, over.bytes)
+        {:ok, prior} = Journal.load(options[:state_dir], id)
+        replacement = arguments(2, head["value"]["revision"], JSON.sha256(over.bytes))
+        value = invoke.(resumed, "source", replacement)
+        value = DocumentSetupJourney.finish(resumed, value, digest)
+        assert value["status"] === "refused", inspect(value)
+
+        code =
+          if kind !== :original_over,
+            do: "document_source_limit",
+            else: "document_acquisition_refused"
+
+        assert Enum.any?(value["gaps"], &(&1["code"] === code))
+        assert value["evidence"] === [] and value["claims"] === []
+        assert head(home, cwd, partition) === head
+        assert {:ok, after_refusal} = Journal.load(options[:state_dir], id)
+        new_events = Enum.drop(after_refusal, length(prior))
+
+        refute Enum.any?(new_events, fn event ->
+                 event["type"] === "extension_action_intent" and
+                   get_in(event, ["request", "op"]) === "collection.store" and
+                   Ipse.Extension.CollectionStore.mutating?(event["request"])
+               end)
+
+        snapshots =
+          Enum.filter(new_events, fn event ->
+            event["type"] === "extension_action_result" and
+              get_in(event, ["request", "op"]) === "tool.call" and
+              get_in(event, ["request", "arguments", "path"]) === @filename
+          end)
+
+        [opening] =
+          Enum.filter(snapshots, &(get_in(&1, ["request", "arguments", "snapshot"]) === "start"))
+
+        pages =
+          Enum.filter(snapshots, &(get_in(&1, ["request", "arguments", "snapshot"]) === "page"))
+
+        if kind !== :original_over do
+          assert opening["outcome"]["status"] === "ok"
+          assert length(pages) === 256 and Enum.all?(pages, &(&1["outcome"]["status"] === "ok"))
+        else
+          assert opening["outcome"]["status"] === "failed" and pages === []
+        end
+
+        File.write!(file, fixture.bytes)
+        assert citations(resumed, fixture, digest) === citations
+
+        %{
+          kind: Atom.to_string(kind),
+          code: code,
+          snapshot_start: opening["outcome"]["status"],
+          pages: length(pages),
+          collection_mutation_intents: 0
+        }
+      end
+
+    assert {:ok, final} = Journal.load(options[:state_dir], id)
+    assert :ok = Session.close_confirmed(resumed)
+    assert {:ok, prior_idle} = Journal.load(options[:state_dir], id)
+
+    assert {:ok, idle} =
+             DynamicSupervisor.start_child(
+               Ipse.Sessions,
+               {Session, Keyword.put(options, :id, id)}
+             )
+
+    assert Session.info(idle).phase === :idle
+    assert :ok = Session.close_confirmed(idle)
+    {after_idle, _} = events(options[:state_dir], id)
+    assert intents(after_idle) === intents(prior_idle)
+    assert acquisitions(after_idle) === acquisitions(final)
+    assert head(home, cwd, partition) === head
+    assert File.read!(file) === fixture.bytes
+
+    report = %{
+      source_id: @source,
+      original_bytes: fixture.original_bytes,
+      text_bytes: fixture.text_bytes,
+      chunks: 32,
+      quote_count: length(citations),
+      extraction_version: "ipse-documents-v17",
+      coverage: "partial",
+      thumbnail_warning_preserved: true,
+      changed_missing_restored: true,
+      saved: true,
+      idle_no_replay: true,
+      model_calls: 0,
+      refusals: refusals
+    }
+
+    File.write!(Path.join(Path.dirname(home), "capacity-result.json"), Jason.encode!(report), [
+      :exclusive,
+      :sync
+    ])
+
+    IO.puts(
+      "INSTALLED_WORD_CAPACITY_PASSED original_bytes=1048576 text_bytes=65536 chunks=32 quotes=3 recipe=v17 partial_thumbnail_warning=preserved changed_missing_restored=true saved_idle_noReplay=true model_calls=0"
+    )
+  end
+
+  defp arguments(generation, revision, hash),
+    do: %{
+      "store" => "notes",
+      "action" => "read_document",
+      "args" => %{
+        "source_id" => @source,
+        "generation" => generation,
+        "expected_revision" => revision,
+        "title" => "Installed capacity Word source",
+        "path" => @filename,
+        "expected_sha256" => hash,
+        "uri" => "workspace:capacity.docx",
+        "observed_at_ms" => 10,
+        "event_at_ms" => nil,
+        "expires_at_ms" => nil
+      }
+    }
+
+  defp head(home, cwd, partition) do
+    assert {:ok, binding} = Ipse.Extension.ProjectIdentity.existing(home, cwd)
+    namespace = Ipse.Extension.CollectionStore.namespace(binding["project_id"])
+
+    assert {:ok, %{"record" => record}} =
+             Ipse.Extension.Collection.execute_profile(
+               Ipse.Extension.CollectionStore.root(home),
+               namespace,
+               %{"op" => "get", "key" => "source." <> partition <> "." <> JSON.sha256(@source)},
+               Ipse.Usage.id(),
+               Ipse.Extension.Collection.Profile.documents()
+             )
+
+    assert is_map(record)
+    assert {:ok, value} = Ipse.Extension.Collection.DocumentStage.decode_packed(record["value"])
+    %{"physical_record" => record, "value" => value}
+  end
+
+  defp query(pid, needle, digest),
+    do:
+      DocumentSetupJourney.invoke(
+        pid,
+        "query_selected",
+        %{
+          "store" => "notes",
+          "retrieval" => "words",
+          "query" => needle,
+          "top_k" => 1,
+          "as_of_ms" => 20,
+          "source_ids" => [@source]
+        },
+        digest
+      )
+
+  defp refused(pid, needle, digest) do
+    value = query(pid, needle, digest)
+    assert value["status"] === "refused"
+    assert value["evidence"] === [] and value["claims"] === []
+    assert Enum.any?(value["gaps"], &(&1["code"] === "document_source_changed_or_unavailable"))
+  end
+
+  defp citations(pid, fixture, digest) do
+    Enum.map(fixture.needles, fn {paragraph, needle} ->
+      result = query(pid, needle, digest)
+      assert result["status"] === "partial"
+      assert [hit] = result["evidence"]
+      citation = hit["citation"]
+      assert citation["document"]["status"] === "partial"
+
+      assert Enum.any?(result["gaps"], fn gap ->
+               gap["code"] === "partial_document" and
+                 Enum.any?(
+                   gap["warnings"] || [],
+                   &(&1["code"] === "internal_relationship_not_examined" and
+                       &1["part"] === "_rels/.rels")
+                 )
+             end)
+
+      quote = needle <> " preserves résumé 雪 evidence. "
+
+      start =
+        fixture.paragraphs
+        |> Enum.take(paragraph - 1)
+        |> Enum.reduce(0, &(byte_size(&1) + 1 + &2))
+
+      assert citation["quote"] === quote
+
+      assert citation["start_byte"] === start and
+               citation["end_byte"] === start + byte_size(quote)
+
+      assert citation["document"]["start_byte"] === 0 and
+               citation["document"]["end_byte"] === byte_size(quote)
+
+      assert citation["content_sha256"] === JSON.sha256(fixture.text)
+      assert citation["document"]["original_sha256"] === JSON.sha256(fixture.bytes)
+      assert citation["document"]["extraction_version"] === "ipse-documents-v17"
+      assert get_in(citation, ["document", "locator", "paragraph"]) === paragraph
+      citation
+    end)
+  end
+
+  defp events(dir, id) do
+    assert {:ok, events} = Journal.load(dir, id)
+    assert {:ok, saved} = Session.Saved.restore(events, id)
+    refute saved.managed_lineage.unavailable
+
+    refute Enum.any?(
+             events,
+             &(&1["type"] in ~w(request_intent request_admitted inference_dispatch_intent managed_output_withheld))
+           )
+
+    {events, saved}
+  end
+
+  defp acquisitions(events),
+    do:
+      Enum.filter(
+        events,
+        &(&1["type"] === "extension_invocation_intent" and
+            get_in(&1, ["payload", "arguments", "action"]) === "read_document" and
+            get_in(&1, ["payload", "arguments", "args", "source_id"]) === @source)
+      )
+
+  defp intents(events),
+    do:
+      Enum.filter(
+        events,
+        &(&1["type"] in ~w(extension_invocation_intent extension_action_intent request_intent request_admitted inference_dispatch_intent worker_input_intent))
+      )
+end
