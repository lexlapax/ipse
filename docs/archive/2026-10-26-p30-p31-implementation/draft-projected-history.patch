+ExUnit.start(autorun: false)
+import ExUnit.Assertions
+{:ok, _} = Application.ensure_all_started(:ipse)
+root = List.last(System.argv())
+multi = "multi" in System.argv()
+question = "question" in System.argv()
+
+expected =
+  cond do
+    multi -> "first replacement line\nsecond replacement line"
+    question -> "suggested request"
+    true -> "accepted replacement"
+  end
+
+defmodule DraftCLIProvider do
+  def complete(config, messages, _, _) do
+    draft =
+      Enum.any?(messages, fn m ->
+        is_binary(m["content"]) and String.contains?(m["content"], "Draft a clearer version")
+      end)
+
+    answered =
+      Enum.any?(messages, &(&1["role"] == "tool" and &1["tool_call_id"] == "draft-question-1"))
+
+    effect_completed =
+      Enum.any?(messages, &(&1["role"] == "tool" and &1["tool_call_id"] == "accepted-write"))
+
+    cond do
+      config[:draft_question] and draft and not answered ->
+        args = %{
+          "questions" => [%{"id" => "detail", "kind" => "text", "prompt" => "What detail?"}]
+        }
+
+        {:ok,
+         %{
+           "role" => "assistant",
+           "content" => "",
+           "tool_calls" => [
+             %{
+               "id" => "draft-question-1",
+               "type" => "function",
+               "function" => %{"name" => "ask_operator", "arguments" => Jason.encode!(args)}
+             }
+           ]
+         }, %{}}
+
+      config[:draft_question] and not draft and not effect_completed ->
+        {:ok,
+         %{
+           "role" => "assistant",
+           "content" => "",
+           "tool_calls" => [
+             %{
+               "id" => "accepted-write",
+               "type" => "function",
+               "function" => %{
+                 "name" => "write",
+                 "arguments" =>
+                   Jason.encode!(%{"path" => "question-effect.txt", "content" => "approved"})
+               }
+             }
+           ]
+         }, %{}}
+
+      true ->
+        {:ok, %{"role" => "assistant", "content" => "suggested request"}, %{}}
+    end
+  end
+end
+
+{:ok, session} =
+  Ipse.Session.start_link(
+    config: %{
+      provider: :demo,
+      model: "synthetic",
+      provider_module: DraftCLIProvider,
+      owner: self(),
+      home: Path.join(root, "home"),
+      approval: if(question, do: :allow, else: :deny),
+      operator_questions: true,
+      draft_question: question,
+      compact: false
+    },
+    cwd: root,
+    state_dir: Path.join(root, "state"),
+    subscriber: self()
+  )
+
+id = Ipse.Session.info(session).id
+monitor = Process.monitor(session)
+assert 0 == Ipse.CLI.Terminal.interact(session, monitor, true, nil, root)
+{:ok, events} = Ipse.Journal.load(Path.join(root, "state"), id)
+
+assert Enum.any?(
+         events,
+         &(&1["type"] == "input_received" and &1["origin"] == "interactive_operator" and
+             &1["text"] == "private initial request")
+       )
+
+if not question do
+  assert Enum.any?(
+           events,
+           &(&1["type"] == "draft_replaced" and &1["version"] == if(multi, do: 3, else: 2) and
+               &1["text"] == expected)
+         )
+end
+
+assert Enum.any?(events, &(&1["type"] == "draft_accepted" and &1["version"] == 2))
+
+if question do
+  answer = Enum.find(events, &(&1["type"] == "operator_answer" and &1["version"] == 2))
+  accepted = Enum.find(events, &(&1["type"] == "draft_accepted"))
+
+  original =
+    Enum.find(
+      events,
+      &(&1["type"] == "input_received" and &1["text"] == "private initial request")
+    )
+
+  assert accepted["question_ids"] == ["draft-question-1"]
+  assert accepted["answer_source_ids"] == [answer["origin"]["source_id"]]
+  assert accepted["input_source_id"] == original["source_id"]
+
+  effect =
+    Enum.find(
+      events,
+      &(&1["type"] == "draft_effect_intent" and &1["call_id"] == "accepted-write")
+    )
+
+  assert [lineage] = effect["possible_source_lineages"]
+  assert lineage["question_ids"] == accepted["question_ids"]
+  assert lineage["answer_source_ids"] == accepted["answer_source_ids"]
+  assert lineage["input_source_id"] == accepted["input_source_id"]
+  assert File.read!(Path.join(root, "question-effect.txt")) == "approved"
+
+  forged =
+    Enum.map(events, fn event ->
+      if event == accepted, do: Map.put(event, "question_ids", []), else: event
+    end)
+
+  assert {:error, _} = Ipse.Session.Saved.restore(forged, id)
+end
+
+assert {:ok, %{draft: %{status: :consumed} = draft, messages: messages}} =
+         Ipse.Session.Saved.restore(events, id)
+
+assert {:ok, final} =
+         Ipse.Session.Draft.project(draft, messages, Ipse.Session.Reference.occurrences(events))
+
+assert Enum.any?(final, &(&1["content"] == expected))
+refute inspect(final) =~ "private initial request"
+refute inspect(final) =~ "private answer canary"
+{:ok, page} = Ipse.Session.sources(session, "source.list", %{"limit" => 32})
+
+for row <- page["sources"] do
+  {:ok, source} = Ipse.Session.sources(session, "source.read", %{"handle" => row["read_handle"]})
+  refute inspect(source) =~ "private initial request"
+  refute inspect(source) =~ "private answer canary"
+end
+
+assert :ok = Ipse.Session.close_confirmed(session)
+IO.puts("SYNTHETIC_DRAFT_CLI_PASSED")
diff --git a/test/support/draft_mcp_resume_pty.exs b/test/support/draft_mcp_resume_pty.exs
new file mode 100644
index 0000000..68ad2ff
--- /dev/null
+++ b/test/support/draft_mcp_resume_pty.exs
@@ -0,0 +1,151 @@
+ExUnit.start(autorun: false)
+import ExUnit.Assertions
+{:ok, _} = Application.ensure_all_started(:ipse)
+root = List.last(System.argv())
+
+defmodule DraftMCPResumeProvider do
+  def complete(config, messages, tools, _) do
+    send(config.fixture_owner, {:model_input, messages, tools})
+    last = messages |> Enum.reject(&Ipse.Session.Reference.reference?/1) |> List.last()
+
+    cond do
+      last["content"] == "preload" ->
+        {:ok, %{"role" => "assistant", "content" => "ready"}, %{}}
+
+      last["role"] == "tool" ->
+        {:ok, %{"role" => "assistant", "content" => "proposal"}, %{}}
+
+      true ->
+        args = %{"questions" => [%{"id" => "detail", "kind" => "text", "prompt" => "Detail?"}]}
+
+        {:ok,
+         %{
+           "role" => "assistant",
+           "content" => "",
+           "tool_calls" => [
+             %{
+               "id" => "draft-q",
+               "type" => "function",
+               "function" => %{"name" => "ask_operator", "arguments" => Jason.encode!(args)}
+             }
+           ]
+         }, %{}}
+    end
+  end
+end
+
+document = %{
+  "servers" => [
+    %{
+      "id" => "notes",
+      "command" => System.find_executable("elixir"),
+      "args" => [
+        "--erl",
+        "+S 2:2",
+        "-pa",
+        Path.dirname(to_string(:code.which(Jason))),
+        Path.expand("test/support/mcp_catalog_server.exs"),
+        "normal"
+      ],
+      "resources" => ["notes://guide"],
+      "prompts" => ["summarize"],
+      "env" => %{"PATH" => Path.join(to_string(:code.root_dir()), "bin") <> ":/usr/bin:/bin"},
+      "timeout_ms" => 5_000
+    }
+  ]
+}
+
+path = Path.join(root, "mcp.json")
+File.write!(path, Jason.encode!(document))
+{:ok, servers} = Ipse.MCP.Config.load(path)
+
+config = %{
+  provider: :demo,
+  model: "catalog-fixture",
+  provider_module: DraftMCPResumeProvider,
+  fixture_owner: self(),
+  home: Path.join(root, "home"),
+  mcp_servers: servers,
+  approval: :allow,
+  operator_questions: true
+}
+
+opts = [config: config, cwd: root, state_dir: Path.join(root, "state"), subscriber: self()]
+{:ok, pid} = Ipse.Session.start_link(opts)
+Process.unlink(pid)
+id = Ipse.Session.info(pid).id
+assert :ok = Ipse.Session.prompt(pid, "preload")
+assert_receive {:model_input, _, definitions}, 10_000
+assert_receive {:ipse, ^pid, {:done, :ok}}, 10_000
+assert :ok = Ipse.Session.start_draft(pid, "private requirement")
+assert_receive {:model_input, _, ^definitions}, 10_000
+assert_receive {:ipse, ^pid, {:question, "draft-q", _}}, 10_000
+before = File.read!(Path.join(root, "catalog.log"))
+ref = Process.monitor(pid)
+Process.exit(pid, :kill)
+assert_receive {:DOWN, ^ref, :process, ^pid, _}, 10_000
+
+definitions =
+  if "forge" in System.argv() do
+    journal = Path.join([root, "state", id <> ".jsonl"])
+    bytes = File.read!(journal)
+    {:ok, events} = Ipse.Journal.load(Path.join(root, "state"), id)
+    started = Enum.find(events, &(&1["type"] == "draft_started"))
+    snapshot = started["mcp_snapshot"]
+    original = get_in(snapshot, ["definitions", Access.at(0), "function", "description"])
+    replacement = String.duplicate("X", byte_size(original))
+
+    forged =
+      update_in(snapshot["definitions"], fn defs ->
+        List.update_at(defs, 0, &put_in(&1, ["function", "description"], replacement))
+      end)
+
+    old_self = snapshot["definitions_sha256"]
+    new_self = Ipse.JSON.digest(forged["definitions"])
+    old_catalog = Ipse.JSON.digest(snapshot["base_definitions"] ++ snapshot["definitions"])
+    new_catalog = Ipse.JSON.digest(forged["base_definitions"] ++ forged["definitions"])
+
+    changed =
+      bytes
+      |> String.replace(original, replacement, global: false)
+      |> String.replace(old_self, new_self, global: false)
+      |> String.replace(old_catalog, new_catalog)
+
+    assert byte_size(changed) == byte_size(bytes)
+    File.write!(journal, changed)
+    snapshot["base_definitions"] ++ forged["definitions"]
+  else
+    definitions
+  end
+
+{:ok, resumed} = Ipse.Session.start_link(Keyword.put(opts, :id, id))
+owner = self()
+
+reader =
+  spawn(fn ->
+    receive do
+      {:read, channel, request} ->
+        send(owner, {:result, Ipse.Session.observe_channel(resumed, channel, request, 30_000)})
+
+        receive do
+          :stop -> :ok
+        end
+    end
+  end)
+
+{:ok, channel} = Ipse.Session.open_input_channel(resumed, reader)
+{:ok, render} = Ipse.Session.render_question(resumed, channel, "detail")
+send(reader, {:read, channel, %{"kind" => "question", "render_id" => render["render_id"]}})
+assert_receive {:result, {:ok, text, witness}}, 10_000
+assert :ok = Ipse.Session.answer_observed(resumed, channel, render["render_id"], text, witness)
+send(reader, :stop)
+assert_receive {:ipse, ^resumed, {:error, reason}}, 10_000
+assert reason =~ "cannot be independently verified"
+assert_receive {:ipse, ^resumed, {:done, :error}}, 10_000
+refute_receive {:model_input, _, ^definitions}, 200
+assert File.read!(Path.join(root, "catalog.log")) == before
+assert :ok = Ipse.Session.cancel_draft(resumed)
+assert :ok = Ipse.Session.close_confirmed(resumed)
+{:ok, events} = Ipse.Journal.load(Path.join(root, "state"), id)
+assert {:ok, _} = Ipse.Session.Saved.restore(events, id)
+IO.puts("SYNTHETIC_DRAFT_MCP_RESUME_PASSED")
diff --git a/test/support/draft_operator_pty.exs b/test/support/draft_operator_pty.exs
new file mode 100644
index 0000000..72f7106
