+      do: {:ok, %{d | tool_evidence: d.tool_evidence ++ [source]}},
+      else: @error
+  end
+
+  defp step(
+         %{status: :pending, message: true, assistant: m} = d,
+         %{"type" => "draft_completed"} = e,
+         _
+       )
+       when is_map(m) do
+    if text?(m["content"]) and m["tool_calls"] in [nil, []] and
