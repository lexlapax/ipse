+         ~w(type version session_id turn_id draft_id revision end_count segment_sha256 notice_sha256)
+       ) and
+         e["version"] === 1 and e["session_id"] == d.session_id and e["turn_id"] == d.turn_id and
+         e["draft_id"] == d.id and e["revision"] === d.revision and
+         JSON.safe_uint?(e["end_count"]) and e["end_count"] >= d.prefix_count and
+         JSON.sha256?(e["segment_sha256"]) and e["notice_sha256"] == JSON.sha256(@notice),
+       do:
+         {:ok,
+          %{
+            d
+            | status: :cancelled,
+              end_count: e["end_count"],
+              segment_sha256: e["segment_sha256"]
+          }},
+       else: @error
+  end
+
+  defp step(
+         %{status: :cancelled, notice: false} = d,
+         %{"type" => "message", "message" => %{"role" => "user", "content" => text}},
+         _
+       ) do
+    if text == @notice, do: {:ok, %{d | notice: true}}, else: @error
+  end
+
+  defp step(d, %{"type" => "draft_rebased"} = event, _) when is_map(d) do
+    if terminal?(d) and
+         keys?(event, ~w(type version session_id draft_id revision before_sha256 after_sha256)) and
+         event["version"] === 1 and event["session_id"] == d.session_id and
+         event["draft_id"] == d.id and event["revision"] === d.revision and
+         JSON.sha256?(event["before_sha256"]) and JSON.sha256?(event["after_sha256"]),
+       do: {:ok, nil},
+       else: @error
+  end
+
+  defp step(_d, %{"type" => type}, _)
+       when type in ~w(draft_started draft_completed draft_cancelled draft_replaced draft_accepted draft_consumed),
+       do: @error
+
+  defp step(%{status: :cancelled, notice: true} = d, %{"type" => "input_received"}, _),
+    do: {:ok, d}
+
+  defp step(
+         %{status: :consumed, accepted_message: true} = d,
+         %{"type" => "input_received", "turn_id" => turn},
+         _
+       ),
+       do: {:ok, %{d | current_turn: turn, active_calls: [], pending_effect: nil}}
+
+  defp step(
+         %{status: :consumed, accepted_message: true} = d,
+         %{"type" => "message", "message" => %{"role" => "assistant"} = message},
+         _
+       ) do
+    calls = if is_list(message["tool_calls"]), do: message["tool_calls"], else: []
+    {:ok, %{d | active_calls: calls}}
+  end
+
+  defp step(
+         %{status: :consumed, accepted_message: true} = d,
+         %{"type" => "draft_effect_intent", "call_id" => id} = event,
+         _
+       ) do
+    case Enum.find(d.active_calls, &(&1["id"] == id)) do
+      call when is_map(call) ->
+        if d.current_turn == d.accepted_turn and d.pending_effect == nil and
+             effect_intent(d, call) === event,
+           do: {:ok, %{d | pending_effect: %{id: id, name: get_in(call, ["function", "name"])}}},
+           else: @error
+
+      _ ->
+        @error
+    end
+  end
+
+  defp step(_, %{"type" => "draft_effect_intent"}, _), do: @error
+
+  defp step(d, %{"type" => "input_received"}, _) when is_map(d), do: @error
+  defp step(d, _, _), do: {:ok, d}
+
+  defp valid_lines?(text, pieces) when is_list(pieces) and length(pieces) in 1..16 do
+    Enum.all?(pieces, fn piece ->
+      is_map(piece) and Enum.sort(Map.keys(piece)) == ["observation", "text"] and
+        is_binary(piece["text"]) and String.valid?(piece["text"]) and
+        not String.contains?(piece["text"], ["\n", "\r"]) and
+        Ipse.Session.Input.valid_observation?(piece["observation"], piece["text"], 2)
+    end) and Enum.map_join(pieces, "\n", & &1["text"]) == text
+  end
+
+  defp valid_lines?(_, _), do: false
+
+  defp next_draft(d, event, session) do
+    history = d.history ++ [Map.delete(d, :history)]
+
+    with true <- length(history) < 16,
+         {:ok, next} <- step(nil, event, session),
+         do: {:ok, %{next | history: history}},
+         else: (_ -> @error)
+  end
+
+  defp id?(v), do: is_binary(v) and Regex.match?(~r/\A[0-9a-f]{32}\z/, v)
+  defp valid_model?(nil), do: true
+  defp valid_model?(v), do: Ipse.Provider.model_name(v) == v
+  defp keys?(v, keys), do: Enum.sort(Map.keys(v)) == Enum.sort(keys)
+end
diff --git a/lib/ipse/session/draft_acceptance.ex b/lib/ipse/session/draft_acceptance.ex
new file mode 100644
index 0000000..e2bd503
--- /dev/null
+++ b/lib/ipse/session/draft_acceptance.ex
@@ -0,0 +1,133 @@
+defmodule Ipse.Session.DraftAcceptance do
+  @moduledoc false
+  alias Ipse.{JSON, Usage}
+
+  def render(draft, channel) do
+    code = Usage.id()
+    id = Usage.id()
+
+    if id?(channel) and is_map(draft) and Ipse.Session.Draft.text?(draft.proposal) do
+      {:ok,
+       %{
+         "version" => 1,
+         "render_id" => id,
+         "channel_id" => channel,
+         "draft_id" => draft.id,
+         "revision" => draft.revision,
+         "code" => code,
+         "display" => display(draft.proposal, code)
+       }}
+    else
+      {:error, :invalid_draft_render}
+    end
+  end
+
+  def receipt(draft, render, text, observation) do
+    with true <- valid_render?(draft, render),
+         true <- text == "accept " <> render["code"],
+         true <- Ipse.Session.Input.valid_observation?(observation, text, 2),
+         true <- observation["display_sha256"] == JSON.sha256(render["display"]) do
+      {:ok,
+       %{
+         "version" => 1,
+         "render_id" => render["render_id"],
+         "channel_id" => render["channel_id"],
+         "draft_id" => render["draft_id"],
+         "revision" => render["revision"],
+         "code" => render["code"],
+         "input" => text,
+         "observation" => observation
+       }}
+    else
+      _ -> {:error, :invalid_draft_acceptance}
+    end
+  end
+
+  def valid_receipt?(draft, receipt) when is_map(receipt) do
+    with true <-
+           Enum.sort(Map.keys(receipt)) ==
+             ~w(channel_id code draft_id input observation render_id revision version),
+         true <-
+           receipt["version"] === 1 and id?(receipt["render_id"]) and id?(receipt["channel_id"]) and
+             id?(receipt["code"]),
+         {:ok, ^receipt} <-
+           receipt(
+             draft,
+             %{
+               "version" => 1,
+               "render_id" => receipt["render_id"],
+               "channel_id" => receipt["channel_id"],
+               "draft_id" => receipt["draft_id"],
+               "revision" => receipt["revision"],
+               "code" => receipt["code"],
+               "display" => display(draft.proposal, receipt["code"])
+             },
+             receipt["input"],
+             receipt["observation"]
+           ) do
+      true
+    else
+      _ -> false
+    end
+  end
+
+  def valid_receipt?(_, _), do: false
+
+  def validate_observation_uniqueness(events) do
+    Enum.reduce_while(events, MapSet.new(), fn event, seen ->
+      ids =
+        case event do
+          %{"type" => "input_received", "observation" => %{"event_id" => id}} ->
+            [id]
+
+          %{"type" => "draft_replaced", "version" => 2, "observation" => %{"event_id" => id}} ->
+            [id]
+
+          %{"type" => "draft_replaced", "version" => 3, "pieces" => pieces}
+          when is_list(pieces) ->
+            Enum.map(pieces, &get_in(&1, ["observation", "event_id"]))
+
+          %{"type" => "operator_answer", "origin" => %{"pieces" => pieces}}
+          when is_list(pieces) ->
+            Enum.map(pieces, &get_in(&1, ["observation", "event_id"]))
+
+          %{
+            "type" => "draft_accepted",
+            "version" => 2,
+            "receipt" => %{"observation" => %{"event_id" => id}}
+          } ->
+            [id]
+
+          _ ->
+            []
+        end
+
+      if Enum.any?(ids, &(not id?(&1) or MapSet.member?(seen, &1))) or
+           length(ids) != length(Enum.uniq(ids)),
+         do: {:halt, {:error, :duplicate_operator_observation}},
+         else: {:cont, Enum.reduce(ids, seen, &MapSet.put(&2, &1))}
+    end)
+    |> case do
+      %MapSet{} -> :ok
+      error -> error
+    end
+  end
+
+  defp valid_render?(draft, render) when is_map(draft) and is_map(render) do
+    Enum.sort(Map.keys(render)) == ~w(channel_id code display draft_id render_id revision version) and
+      render["version"] === 1 and id?(render["render_id"]) and id?(render["channel_id"]) and
+      id?(render["code"]) and render["draft_id"] == draft.id and
+      render["revision"] === draft.revision and
+      render["display"] == display(draft.proposal, render["code"])
+  end
+
+  defp valid_render?(_, _), do: false
+
+  defp display(text, code),
+    do:
+      "Proposed request:\n" <>
+        Ipse.CLI.Terminal.escape(text) <>
+        "\n\nType accept " <> code <> " to submit this exact request.\ndraft> "
+
+  defp id?(value), do: is_binary(value) and Regex.match?(~r/\A[0-9a-f]{32}\z/, value)
+end
diff --git a/lib/ipse/session/draft_history.ex b/lib/ipse/session/draft_history.ex
new file mode 100644
index 0000000..6b581b7
--- /dev/null
+++ b/lib/ipse/session/draft_history.ex
@@ -0,0 +1,53 @@
+defmodule Ipse.Session.DraftHistory do
+  @moduledoc false
+  alias Ipse.Journal
+  @max_records 65_536
+  @max_bytes 33_554_432
+
+  def withheld(directory, session, upper)
+      when is_integer(upper) and upper >= 0 and upper <= @max_bytes do
+    with {:ok, records} <- scan(directory, session, upper, 0, []),
+         events = Enum.map(records, & &1.record),
+         {:ok, _} <- Ipse.Session.Draft.restore(events, session),
+         :ok <- Ipse.Session.Input.validate_events(events, session),
+         :ok <- Ipse.Session.OperatorAnswer.validate_events(events, session) do
+      {ranges, start} =
+        Enum.reduce(records, {[], nil}, fn %{record: event, source: source}, {ranges, start} ->
+          case {event["type"], start} do
+            {"draft_started", nil} ->
+              {ranges, source["byte_offset"]}
+
+            {type, current}
+            when type in ["draft_cancelled", "draft_consumed"] and is_integer(current) ->
+              {[{current, source["byte_offset"]} | ranges], nil}
+
+            _ ->
+              {ranges, start}
+          end
+        end)
+
+      if is_nil(start), do: {:ok, ranges}, else: {:error, :pending_draft_history}
+    end
+  rescue
+    _ -> {:error, :invalid_draft_history}
+  end
+
+  def withheld(_, _, _), do: {:error, :invalid_draft_history}
+
+  def withheld?(ranges, offset),
+    do: Enum.any?(ranges, fn {first, last} -> offset >= first and offset <= last end)
+
+  defp scan(_, _, upper, upper, acc), do: {:ok, Enum.reverse(acc)}
+
+  defp scan(dir, session, upper, cursor, acc) when length(acc) < @max_records do
+    with {:ok, page} <- Journal.source_page(dir, session, cursor, 64, upper),
+         true <- page.records != [] do
+      next = page.next || upper
+      scan(dir, session, upper, next, Enum.reverse(page.records, acc))
+    else
+      _ -> {:error, :invalid_draft_history}
+    end
+  end
+
+  defp scan(_, _, _, _, _), do: {:error, :draft_history_capacity}
+end
diff --git a/lib/ipse/session/draft_lineage.ex b/lib/ipse/session/draft_lineage.ex
new file mode 100644
index 0000000..d8052e7
--- /dev/null
+++ b/lib/ipse/session/draft_lineage.ex
@@ -0,0 +1,230 @@
+defmodule Ipse.Session.DraftLineage do
+  @moduledoc false
+  alias Ipse.JSON
+  @limit 16
+  @error {:error, :invalid_draft_lineage}
+
+  def limit, do: @limit
+
+  def entry(accepted, turn) do
+    %{
+      "draft_id" => accepted["draft_id"],
+      "revision" => accepted["revision"],
+      "accepted_turn_id" => turn,
+      "accepted_sha256" => JSON.digest([accepted]),
+      "input_source_id" => accepted["input_source_id"],
+      "question_ids" => accepted["question_ids"],
+      "answer_source_ids" => accepted["answer_source_ids"],
+      "tool_evidence" => accepted["tool_evidence"]
+    }
+  end
+
+  def intent(session, turn, call, lineages) do
+    %{
+      "type" => "draft_effect_intent",
+      "version" => 2,
+      "session_id" => session,
+      "turn_id" => turn,
+      "call_id" => call["id"],
+      "call_sha256" => JSON.digest([call]),
+      "possible_source_lineages" => lineages
+    }
+  end
+
+  def inference_intent(session, turn, request, phase, messages, lineages) do
+    %{
+      "type" => "draft_inference_intent",
+      "version" => 1,
+      "session_id" => session,
+      "turn_id" => turn,
+      "request_id" => request,
+      "phase" => phase,
+      "input_sha256" => JSON.digest([messages]),
+      "possible_source_lineages" => lineages
+    }
+  end
+
+  def extension_target?(%{"type" => type})
+       when type in ~w(extension_invocation_intent extension_action_intent extension_model_request extension_decision_request extension_embedding_request extension_transform_intent extension_event_intent extension_feed_intent extension_feed_delivery_intent extension_text_intent extension_continuation_intent),
+      do: true
+
+  def extension_target?(%{"type" => "request_admitted", "kind" => kind})
+      when kind not in ["model", "compaction"], do: true
+
+  def extension_target?(%{"type" => "inference_dispatch_intent", "phase" => phase})
+      when phase not in ["model", "compaction"], do: true
+
+  def extension_target?(_), do: false
+
+  def extension_intent(session, turn, event, lineages) do
+    %{
+      "type" => "draft_extension_intent",
+      "version" => 1,
+      "session_id" => session,
+      "turn_id" => turn,
+      "target_type" => event["type"],
+      "target_sha256" => JSON.digest([event]),
+      "possible_source_lineages" => lineages
+    }
+  end
+
+  # Conservative lineage remains attached after compaction: the host cannot
+  # establish that summaries or later turns are independent of earlier inputs.
+  def restore(events, session) when is_list(events) do
+    session =
+      session ||
+        Enum.find_value(events, &if(&1["type"] == "draft_consumed", do: &1["session_id"]))
+
+    initial = %{
+      lineages: [],
+      accepted: nil,
+      turn: nil,
+      calls: [],
+      pending: nil,
+      request: nil,
+      extension_pending: nil
+    }
+
+    Enum.reduce_while(events, {:ok, initial}, fn event, {:ok, state} ->
+      with {:ok, state} <- extension_step(state, event, session),
+           {:ok, next} <- step(state, event, session) do
+        {:cont, {:ok, next}}
+      else
+        _ -> {:halt, @error}
+      end
+    end)
+    |> case do
+      {:ok, state} -> {:ok, state.lineages}
+      error -> error
+    end
+  rescue
+    _ -> @error
+  end
+
+  defp extension_step(s, %{"type" => "draft_extension_intent"} = event, session) do
+    if s.lineages != [] and s.extension_pending == nil and event["session_id"] == session and
+         event["turn_id"] == s.turn and event["possible_source_lineages"] == s.lineages and
+         event["version"] === 1 and JSON.sha256?(event["target_sha256"]) and
+         Enum.sort(Map.keys(event)) ==
+           ~w(possible_source_lineages session_id target_sha256 target_type turn_id type version),
+       do: {:ok, %{s | extension_pending: event}},
+       else: @error
+  end
+
+  defp extension_step(s, event, session) do
+    cond do
+      extension_target?(event) and s.lineages != [] ->
+        if s.extension_pending === extension_intent(session, s.turn, event, s.lineages),
+          do: {:ok, %{s | extension_pending: nil}},
+          else: @error
+
+      event["type"] in ~w(input_received lifecycle_epoch_started) ->
+        {:ok, %{s | extension_pending: nil}}
+
+      s.extension_pending != nil ->
+        @error
+
+      true ->
+        {:ok, s}
+    end
+  end
+
+  defp step(s, %{"type" => "draft_accepted", "version" => 2} = event, _),
+    do: {:ok, %{s | accepted: event}}
+
+  defp step(s, %{"type" => "draft_cancelled"}, _), do: {:ok, %{s | accepted: nil}}
+
+  defp step(
+         %{accepted: accepted} = s,
+         %{"type" => "draft_consumed", "draft_id" => id, "accepted_turn_id" => turn},
+         _
+       )
+       when is_map(accepted) do
+    if accepted["draft_id"] == id and length(s.lineages) < @limit,
+      do: {:ok, %{s | lineages: s.lineages ++ [entry(accepted, turn)], accepted: nil}},
+      else: @error
+  end
+
+  defp step(s, %{"type" => "input_received", "turn_id" => turn}, _),
+    do: {:ok, %{s | turn: turn, calls: [], pending: nil, request: nil}}
+
+  defp step(
+         %{lineages: [_ | _]} = s,
+         %{"type" => "request_admitted", "request_id" => id, "turn_id" => turn, "kind" => kind},
+         _
+       )
+       when kind in ["model", "compaction"] do
+    if turn == s.turn and s.request == nil,
+      do: {:ok, %{s | request: %{id: id, phase: kind, input_sha256: nil}}},
+      else: @error
+  end
+
+  defp step(
+         %{request: %{id: request, phase: phase, input_sha256: nil}} = s,
+         %{"type" => "draft_inference_intent"} = event,
+         session
+       ) do
+    if Enum.sort(Map.keys(event)) ==
+         ~w(input_sha256 phase possible_source_lineages request_id session_id turn_id type version) and
+         event["version"] === 1 and event["session_id"] == session and event["turn_id"] == s.turn and
+         event["request_id"] == request and event["phase"] == phase and
+         event["possible_source_lineages"] == s.lineages and JSON.sha256?(event["input_sha256"]),
+       do: {:ok, put_in(s.request.input_sha256, event["input_sha256"])},
+       else: @error
+  end
+
+  defp step(_, %{"type" => "draft_inference_intent"}, _), do: @error
+
+  defp step(
+         %{request: %{id: id, input_sha256: hash}} = s,
+         %{"type" => "inference_dispatch_intent", "request_id" => id, "input_sha256" => hash},
+         _
+       )
+       when is_binary(hash), do: {:ok, s}
+
+  defp step(
+         %{lineages: [_ | _]} = s,
+         %{"type" => "inference_dispatch_intent", "phase" => phase},
+         _
+       )
+       when phase not in ["model", "compaction"], do: {:ok, s}
+
+  defp step(%{lineages: [_ | _]}, %{"type" => "inference_dispatch_intent"}, _), do: @error
+
+  defp step(
+         %{request: %{id: id, input_sha256: hash}} = s,
+         %{"type" => "request_finished", "request_id" => id},
+         _
+       )
+       when is_binary(hash), do: {:ok, %{s | request: nil}}
+
+  defp step(%{request: %{id: id}} = _s, %{"type" => "request_finished", "request_id" => id}, _),
+    do: @error
+
+  defp step(s, %{"type" => "message", "message" => %{"role" => "assistant"} = message}, _),
+    do:
+      {:ok, %{s | calls: if(is_list(message["tool_calls"]), do: message["tool_calls"], else: [])}}
+
+  defp step(s, %{"type" => "draft_effect_intent", "call_id" => id} = event, session) do
+    case Enum.find(s.calls, &(&1["id"] == id)) do
+      call when is_map(call) ->
+        if s.lineages != [] and s.pending == nil and
+             event === intent(session, s.turn, call, s.lineages),
+           do: {:ok, %{s | pending: %{id: id, name: get_in(call, ["function", "name"])}}},
+           else: @error
+
+      _ ->
+        @error
+    end
+  end
+
+  defp step(
+         %{lineages: [_ | _]} = s,
+         %{"type" => "tool_started", "call_id" => id, "name" => name},
+         _
+       ) do
+    if s.pending == %{id: id, name: name}, do: {:ok, %{s | pending: nil}}, else: @error
+  end
+
+  defp step(s, _, _), do: {:ok, s}
+end
diff --git a/lib/ipse/session/draft_mcp.ex b/lib/ipse/session/draft_mcp.ex
new file mode 100644
index 0000000..119e7f8
--- /dev/null
+++ b/lib/ipse/session/draft_mcp.ex
@@ -0,0 +1,77 @@
+defmodule Ipse.Session.DraftMCP do
+  @moduledoc false
+  alias Ipse.JSON
+  @error {:error, :invalid_draft_mcp_catalog}
+
+  def event(session, tools, base_definitions) do
+    manifests = tools |> Ipse.MCP.manifests() |> Jason.encode!() |> Jason.decode!()
+    definitions = Ipse.MCP.definitions(tools)
+
+    %{
+      "type" => "draft_mcp_catalog",
+      "version" => 1,
+      "session_id" => session,
+      "manifests_sha256" => JSON.digest(manifests),
+      "definitions" => definitions,
+      "base_definitions" => base_definitions,
+      "definitions_sha256" => JSON.digest(definitions)
+    }
+  end
+
+  def restore(events, session) do
+    Enum.reduce_while(events, {:ok, nil, nil, nil}, fn event,
+                                                       {:ok, catalog, snapshot, reference} ->
+      case event do
+        %{"type" => "mcp_catalog", "version" => 1, "tools" => tools} when is_list(tools) ->
+          {:cont, {:ok, tools, snapshot, reference}}
+
+        %{"type" => "reference_admitted", "catalog_sha256" => hash} ->
+          {:cont, {:ok, catalog, snapshot, hash}}
+
+        %{"type" => "draft_started"} ->
+          next = event["mcp_snapshot"]
+
+          if is_nil(next) or valid?(next, session || event["session_id"], catalog, reference),
+            do: {:cont, {:ok, catalog, next, reference}},
+            else: {:halt, @error}
+
+        %{"type" => type} when type in ["draft_cancelled", "draft_consumed"] ->
+          {:cont, {:ok, catalog, nil, reference}}
+
+        _ ->
+          {:cont, {:ok, catalog, snapshot, reference}}
+      end
+    end)
+    |> case do
+      {:ok, _, snapshot, _} -> {:ok, snapshot}
+      error -> error
+    end
+  rescue
+    _ -> @error
+  end
+
+  def valid?(event, session, catalog, reference) do
+    definitions = event["definitions"]
+    base = event["base_definitions"]
+
+    Enum.sort(Map.keys(event)) ==
+      ~w(base_definitions definitions definitions_sha256 manifests_sha256 session_id type version) and
+      event["type"] == "draft_mcp_catalog" and event["version"] === 1 and
+      event["session_id"] == session and is_list(catalog) and is_list(definitions) and
