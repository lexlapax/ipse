+++ b/test/ipse/session/draft_native_test.exs
@@ -0,0 +1,141 @@
+defmodule Ipse.Session.DraftNativeTest do
+  use ExUnit.Case, async: true
+  alias Ipse.Session.DraftNative
+
+  defp assistant do
+    %{
+      "role" => "assistant",
+      "content" => "draft answer canary",
+      "provider_data" => %{
+        "provider" => "openai",
+        "reported_model" => "synthetic",
+        "output" => [
+          %{
+            "type" => "reasoning",
+            "id" => "rs_draft",
+            "summary" => [],
+            "content" => nil,
+            "encrypted_content" => "opaque draft canary"
+          },
+          %{
+            "type" => "message",
+            "id" => "msg_draft",
+            "role" => "assistant",
+            "status" => "completed",
+            "phase" => "final_answer",
+            "content" => [
+              %{
+                "type" => "output_text",
+                "text" => "draft answer canary",
+                "annotations" => [],
+                "logprobs" => []
+              }
+            ]
+          }
+        ]
+      }
+    }
+  end
+
+  test "complete stateless Responses interval can be omitted from encoded continuation" do
+    prefix = [%{"role" => "user", "content" => "earlier request"}]
+    segment = [%{"role" => "user", "content" => "private draft canary"}, assistant()]
+    tail = [%{"role" => "user", "content" => "unrelated request"}]
+    assert DraftNative.isolated_responses?(prefix, segment, tail)
+
+    body =
+      Ipse.Provider.OpenAI.request_body(
+        %{provider: :chatgpt, model: "fixture"},
+        prefix ++ tail,
+        []
+      )
+
+    refute inspect(body) =~ "private draft canary"
+    refute inspect(body) =~ "draft answer canary"
+    refute inspect(body) =~ "opaque draft canary"
+    assert body["store"] == false
+    refute Map.has_key?(body, "previous_response_id")
+
+    prior =
+      assistant()
+      |> put_in(["content"], "draft answer canary")
+      |> put_in(["provider_data", "output", Access.at(0), "id"], "rs_prior")
+      |> put_in(["provider_data", "output", Access.at(1), "id"], "msg_prior")
+
+    assert DraftNative.isolated_responses?([prior], segment, tail)
+
+    body_with_prior =
+      Ipse.Provider.OpenAI.request_body(
+        %{provider: :chatgpt, model: "fixture"},
+        [prior | tail],
+        []
+      )
+
+    assert Enum.take(body_with_prior["input"], 2) == prior["provider_data"]["output"]
+  end
+
+  test "unknown items, inconsistent visible text and ambiguous links refuse" do
+    segment = [%{"role" => "user", "content" => "draft"}, assistant()]
+    tail = [%{"role" => "user", "content" => "new"}]
+    bad_text = put_in(assistant(), ["content"], "forged")
+    refute DraftNative.isolated_responses?([], [hd(segment), bad_text], tail)
+    output = get_in(assistant(), ["provider_data", "output"])
+
+    foreign =
+      put_in(
+        assistant(),
+        ["provider_data", "output"],
+        output ++ [%{"type" => "item_reference", "id" => "msg_other"}]
+      )
+
+    refute DraftNative.isolated_responses?([], [hd(segment), foreign], tail)
+    refute DraftNative.isolated_responses?([assistant()], segment, tail)
+
+    annotated =
+      put_in(
+        assistant(),
+        ["provider_data", "output", Access.at(1), "content", Access.at(0), "annotations"],
+        [%{"type" => "file_citation", "file_id" => "old"}]
+      )
+
+    refute DraftNative.isolated_responses?([], [hd(segment), annotated], tail)
+  end
+
+  test "native function calls must match visible calls and remain paired inside the interval" do
+    native = %{
+      "type" => "function_call",
+      "id" => "item_draft",
+      "call_id" => "call_draft",
+      "name" => "read",
+      "arguments" => "{}",
+      "status" => "completed"
+    }
+
+    call = %{
+      "id" => "call_draft",
+      "type" => "function",
+      "function" => %{"name" => "read", "arguments" => "{}"}
+    }
+
+    assistant = %{
+      "role" => "assistant",
+      "content" => "",
+      "tool_calls" => [call],
+      "provider_data" => %{"provider" => "openai", "output" => [native]}
+    }
+
+    result = %{"role" => "tool", "tool_call_id" => "call_draft", "content" => "draft tool result"}
+    tail = [%{"role" => "user", "content" => "new"}]
+    assert DraftNative.isolated_responses?([], [assistant, result], tail)
+    refute DraftNative.isolated_responses?([], [assistant], [result | tail])
+    refute DraftNative.isolated_responses?([assistant, result], [assistant, result], tail)
+    unsafe = put_in(assistant, ["provider_data", "previous_response_id"], "prior")
+    refute DraftNative.isolated_responses?([], [unsafe, result], tail)
+
+    refute DraftNative.isolated_responses?(
+             [],
+             [put_in(assistant, ["tool_calls", Access.at(0), "id"], "forged"), result],
+             tail
+           )
+  end
+end
diff --git a/test/ipse/session/draft_projection_test.exs b/test/ipse/session/draft_projection_test.exs
new file mode 100644
index 0000000..afaa098
--- /dev/null
+++ b/test/ipse/session/draft_projection_test.exs
@@ -0,0 +1,103 @@
+defmodule Ipse.Session.DraftProjectionTest do
+  use ExUnit.Case, async: true
+  alias Ipse.Session.Draft
+  alias Ipse.JSON
+
+  defp projection(segment, prefix \\ []) do
+    notice = %{"role" => "user", "content" => Draft.notice()}
+
+    draft = %{
+      status: :cancelled,
+      notice: true,
+      prefix_count: length(prefix),
+      prefix_sha256: JSON.digest(prefix),
+      end_count: length(prefix) + length(segment),
+      segment_sha256: JSON.digest(segment)
+    }
+
+    {draft, prefix ++ segment ++ [notice, %{"role" => "user", "content" => "new task"}]}
+  end
+
+  test "complete draft interval is withheld, but the neutral notice and new intent remain" do
+    prefix = [
+      %{"role" => "user", "content" => "old"},
+      %{"role" => "assistant", "content" => "old reply"}
+    ]
+
+    segment = [
+      %{"role" => "user", "content" => "secret draft"},
+      %{"role" => "assistant", "content" => "draft answer"}
+    ]
+
+    {draft, messages} = projection(segment, prefix)
+    assert {:ok, [_, _, notice, new]} = Draft.project(draft, messages)
+    assert notice["content"] == Draft.notice() and new["content"] == "new task"
+  end
+
+  test "changed bound prefix, draft, notice and invalid range refuse" do
+    {draft, messages} = projection([%{"role" => "user", "content" => "draft"}])
+
+    assert {:error, :draft_projection_unsafe} =
+             Draft.project(
+               draft,
+               List.replace_at(messages, 0, %{"role" => "user", "content" => "changed"})
+             )
+
+    assert {:error, :draft_projection_unsafe} =
+             Draft.project(
+               draft,
+               List.replace_at(messages, 1, %{"role" => "user", "content" => "forged"})
+             )
+
+    assert {:error, :draft_projection_unsafe} = Draft.project(%{draft | end_count: 99}, messages)
+  end
+
+  test "opaque continuation, checkpoint and reference inside the removed interval refuse" do
+    for marker <- ["provider_data", "ipse_checkpoint", "ipse_reference"] do
+      segment = [%{"role" => "assistant", "content" => "sensitive", marker => %{}}]
+      {draft, messages} = projection(segment)
+      assert {:error, :draft_projection_unsafe} = Draft.project(draft, messages)
+    end
+  end
+
+  test "a self-hashed reference is not evidence of a host occurrence" do
+    id = String.duplicate("a", 32)
+    content = Ipse.Session.Reference.content(%{"runtime" => %{}})
+
+    event = %{
+      "version" => 1,
+      "session_id" => id,
+      "turn_id" => id,
+      "epoch" => 1,
+      "source_generation" => 1,
+      "policy_generation" => 0,
+      "content" => content,
+      "content_sha256" => JSON.sha256(content)
+    }
+
+    reference = Ipse.Session.Reference.message(event)
+    assert Ipse.Session.Reference.reference?(reference)
+    {draft, messages} = projection([reference])
+    assert {:error, :draft_projection_unsafe} = Draft.project(draft, messages)
+    assert {:ok, _} = Draft.project(draft, messages, MapSet.new([JSON.digest([reference])]))
+  end
+
+  test "interrupted consumption still authenticates the withdrawn segment" do
+    {cancelled, messages} = projection([%{"role" => "user", "content" => "secret"}])
+    incomplete = cancelled |> Map.put(:status, :consumed) |> Map.put(:accepted_message, false)
+    segment_only = Enum.take(messages, incomplete.end_count)
+    assert {:ok, ^segment_only} = Draft.project(incomplete, segment_only)
+
+    assert {:error, :draft_projection_unsafe} =
+             Draft.project(
+               incomplete,
+               segment_only ++ [%{"role" => "user", "content" => "unexpected"}]
+             )
+
+    assert {:error, :draft_projection_unsafe} =
+             Draft.project(
+               %{incomplete | segment_sha256: String.duplicate("0", 64)},
+               segment_only
+             )
+  end
+end
