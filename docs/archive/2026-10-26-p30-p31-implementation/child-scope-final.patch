+          assert_receive {:cast_outcome, {:unknown, :effect_interrupted}}, 5000
+      end
+    after
+      if Process.alive?(guard), do: :erlang.resume_process(guard)
+      send(worker, :done)
+      if Process.alive?(root), do: Resources.close(root)
