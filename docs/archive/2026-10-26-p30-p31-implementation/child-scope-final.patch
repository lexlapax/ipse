+          :start ->
+            Resources.bind(root)
+
+            outcome =
+              Resources.controlled_file_effect(
+                fn ->
+                  send(parent, {:ready, self(), Resources.current()})
+
+                  receive do
+                    :continue ->
+                      send(parent, :effect_after_close)
+                      :effect_returned
+                  end
+                end,
+                3000
+              )
+
+            send(parent, {:outcome, outcome})
+            receive do: (:done -> :ok)
+        end
+      end)
