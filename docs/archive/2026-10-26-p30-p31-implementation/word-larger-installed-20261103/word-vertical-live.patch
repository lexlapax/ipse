+          row =
+            if is_nil(change["value"]) do
+              nil
+            else
+              %{
+                "value" => change["value"],
+                "revision" => change["expected_revision"] + 1,
+                "operation_id" => operation
+              }
+            end
+
+          {change["key"], row}
+        end)
+
+      proposed_read = fn key ->
+        case Map.fetch(overlay, key) do
+          {:ok, row} -> {:ok, row}
+          :error -> read.(key)
