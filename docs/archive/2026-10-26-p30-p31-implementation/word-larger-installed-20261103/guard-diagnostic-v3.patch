+  @doc false
+  def diagnostic_phase(label, fun) do
+    pid = self() |> :erlang.pid_to_list() |> List.to_string()
+
+    mark = fn state ->
+      IO.puts("WORD_DIAG #{label} #{state} #{pid} #{System.monotonic_time(:microsecond)}")
+    end
+
+    mark.("start")
+
+    try do
+      result = fun.()
+
+      class =
+        case result do
+          :ok -> "ok"
+          true -> "true"
+          false -> "false"
+          {:ok, true} -> "selected"
+          {:ok, false} -> "different"
+          {:ok, :workspace} -> "workspace"
+          {:ok, :legacy_workspace} -> "legacy_workspace"
+          {:ok, :supplied} -> "supplied"
+          {:ok, :other_source} -> "other_source"
+          {:ok, _} -> "ok"
+          {:error, _} -> "error"
+          {:unknown, _} -> "unknown"
+          _ -> "other"
+        end
+
+      mark.(class)
+      result
+    rescue
+      error ->
+        mark.("raised")
+        reraise error, __STACKTRACE__
+    catch
+      kind, reason ->
+        mark.("caught")
+        :erlang.raise(kind, reason, __STACKTRACE__)
+    end
+  end
+
