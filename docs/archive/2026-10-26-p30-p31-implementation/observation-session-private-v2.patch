+defmodule Ipse.Session.ObservationReplay do
+  @moduledoc false
+  alias Ipse.{JSON, Session.ObservationAsync}
+  alias Ipse.Extension.{Actions, CollectionCall, SemanticAdmission}
+  @error {:error, :observation_replay_refused}
+
+  # Diagnostic-only selection in the disposable graph. Production must derive
+  # reviewed bundle identity from verified installed artifacts and policy.
+  def prototype_header(metadata, config) do
+    if config[:private_observation_guard] == true do
+      a = metadata["semantic_admission"]
+      pin = a["pin"]
+      true = SemanticAdmission.valid?(a, pin["session_id"]) and a["version"] === 2
+
+      Map.put(metadata, "observation_lineage", %{
+        "version" => 1,
+        "artifact_sha256" => a["policy"]["artifact_sha256"],
+        "identity_sha256" => pin["identity_sha256"],
+        "pin_sha256" => JSON.digest([pin])
+      })
+    else
+      metadata
+    end
+  end
+
+  def prototype_resume?(metadata, config),
+    do:
+      Map.has_key?(metadata, "observation_lineage") ==
+        (config[:private_observation_guard] == true)
+
+  def prototype_block_read?(config, parent, request) do
+    config[:private_observation_guard] == true and is_map(parent) and
+      JSON.digest([parent["identity"]]) ==
+        get_in(config, [:semantic_admission, "pin", "identity_sha256"]) and
+      CollectionCall.operation?(request) and not CollectionCall.mutating?(request)
+  rescue
+    _ -> true
+  end
+
+  # Private fail-closed experiment. The real host must create this versioned
+  # header from a verified reviewed bundle, never from a worker or request.
+  # No result of this function grants permission to use observed values.
+  def check(events, session_id \\ nil)
+
+  def check([%{"metadata" => metadata} | _] = events, session_id) when is_map(metadata) do
+    case Map.fetch(metadata, "observation_lineage") do
+      :error ->
+        if Enum.any?(events, &(&1["type"] == "collection_observation_transaction")),
+          do: @error,
+          else: :ok
+
+      {:ok, header} ->
+        with true <- header?(header, metadata, session_id),
+             {:ok, normalized, envelopes} <- normalize(events),
+             {:ok, _} <- Actions.restore(normalized),
+             {:ok, required} <- required(normalized, header),
+             :ok <- verify_envelopes(events, required, envelopes) do
+          if required == [], do: :ok, else: {:error, :observation_live_barrier_unavailable}
+        else
+          _ -> @error
+        end
+    end
+  rescue
+    _ -> @error
+  end
+
+  def check(_, _), do: @error
+
+  defp header?(header, metadata, session_id) do
+    a = metadata["semantic_admission"]
+    pin = if is_map(a), do: a["pin"]
+
+    with true <-
+           is_map(header) and
+             Enum.sort(Map.keys(header)) == ~w(artifact_sha256 identity_sha256 pin_sha256 version),
+         true <-
+           header["version"] === 1 and
+             Enum.all?(~w(artifact_sha256 identity_sha256 pin_sha256), &JSON.sha256?(header[&1])),
+         true <- SemanticAdmission.valid?(a, session_id) and a["version"] === 2 and is_map(pin),
+         true <-
+           header["identity_sha256"] === pin["identity_sha256"] and
+             header["pin_sha256"] === JSON.digest([pin]),
+         true <- header["artifact_sha256"] === a["policy"]["artifact_sha256"],
+         identities when is_list(identities) <- metadata["extensions"],
+         [_] <-
+           Enum.filter(
+             identities,
+             &(JSON.digest([&1]) == header["identity_sha256"] and
+                 &1["artifact_sha256"] == header["artifact_sha256"])
+           ) do
+      true
+    else
+      _ -> false
+    end
+  end
+
+  defp normalize(events) do
+    Enum.reduce_while(events, {:ok, [], []}, fn event, {:ok, normalized, envelopes} ->
+      case event do
+        %{"type" => "collection_observation_transaction", "action" => action}
+        when is_map(action) ->
+          {:cont, {:ok, [action | normalized], [event | envelopes]}}
+
+        %{"type" => type}
+        when type in ["collection_observation_begin", "collection_observation_receipt"] ->
+          {:halt, @error}
+
+        _ when is_map(event) ->
+          {:cont, {:ok, [event | normalized], envelopes}}
+
+        _ ->
+          {:halt, @error}
+      end
+    end)
+    |> case do
+      {:ok, normalized, envelopes} -> {:ok, Enum.reverse(normalized), Enum.reverse(envelopes)}
+      error -> error
+    end
+  end
+
+  defp required(events, header) do
+    Enum.reduce_while(events, {:ok, []}, fn event, {:ok, acc} ->
+      request = event["request"]
+
+      selected =
+        event["type"] == "extension_action_intent" and
+          event["identity_sha256"] == header["identity_sha256"] and
+          CollectionCall.operation?(request) and not CollectionCall.mutating?(request)
+
+      cond do
+        not selected -> {:cont, {:ok, acc}}
+        get_in(request, ["request", "op"]) not in ~w(get snapshot scan) -> {:halt, @error}
+        JSON.digest([event["effect_binding"]["pin"]]) != header["pin_sha256"] -> {:halt, @error}
+        length(acc) >= 512 -> {:halt, @error}
+        true -> {:cont, {:ok, [event | acc]}}
+      end
+    end)
+    |> case do
+      {:ok, values} -> {:ok, Enum.reverse(values)}
+      error -> error
+    end
+  end
+
+  defp verify_envelopes(events, required, envelopes) do
+    ids = Enum.map(required, & &1["operation_id"])
+
+    with true <- length(Enum.uniq(ids)) == length(ids) and length(envelopes) == length(required),
+         expected = Map.new(required, &{&1["operation_id"], &1}),
+         {:ok, seen} <- verify_order(events, expected, %{}),
+         true <-
+           map_size(seen) == map_size(expected) and Enum.all?(Map.values(seen), &(&1 == :done)) do
+      :ok
+    else
+      _ -> @error
+    end
+  end
+
+  defp verify_order([], _, seen), do: {:ok, seen}
+
+  defp verify_order(
+         [%{"type" => "extension_action_intent", "operation_id" => id} = event | rest],
+         expected,
+         seen
+       ) do
+    case expected[id] do
+      nil ->
+        verify_order(rest, expected, seen)
+
+      ^event ->
+        if(Map.has_key?(seen, id),
+          do: @error,
+          else: verify_order(rest, expected, Map.put(seen, id, :intent))
+        )
+
+      _ ->
+        @error
+    end
+  end
+
+  defp verify_order(
+         [
+           %{"type" => "collection_observation_transaction", "action" => %{"operation_id" => id}} =
+             event
+           | rest
+         ],
+         expected,
+         seen
+       ) do
+    with intent when is_map(intent) <- expected[id],
+         :intent <- seen[id],
+         {:ok, _} <- ObservationAsync.replay(intent, event) do
+      verify_order(rest, expected, Map.put(seen, id, :done))
+    else
+      _ -> @error
+    end
+  end
+
+  defp verify_order(
+         [%{"type" => "extension_action_result", "operation_id" => id} | rest],
+         expected,
+         seen
+       ) do
+    if Map.has_key?(expected, id), do: @error, else: verify_order(rest, expected, seen)
+  end
+
+  defp verify_order([%{"type" => type} | rest], expected, seen)
+       when type in ~w(cancelled turn_finished),
+       do:
+         if(Enum.any?(Map.values(seen), &(&1 == :intent)),
+           do: @error,
+           else: verify_order(rest, expected, seen)
+         )
+
+  defp verify_order([_ | rest], expected, seen), do: verify_order(rest, expected, seen)
+end
