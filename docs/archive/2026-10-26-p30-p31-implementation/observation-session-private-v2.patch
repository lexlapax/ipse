+defmodule Ipse.Session.ObservationAsyncDiagnosticTest do
+  use ExUnit.Case, async: false
+  alias Ipse.{JSON, Journal, Usage}
+  alias Ipse.Session.{ObservationAdmission, ObservationAsync, Resources}
+  alias Ipse.Extension.Collection.ObservedRead
+
+  defmodule Owner do
+    use GenServer
+    def start(args), do: GenServer.start(__MODULE__, args)
+    @impl true
+    def init(args) do
+      {:ok, id} = Journal.create(args.dir, %{})
+      {:ok, writer} = Journal.Writer.start(args.dir, id, self())
+      {:ok, scope} = Resources.start(self())
+      {:ok, Map.merge(args, %{id: id, writer: writer, scope: scope, pending: nil})}
+    end
+
+    @impl true
+    def handle_call(:writer, _, s), do: {:reply, s.writer, s}
+    def handle_call(:ping, _, s), do: {:reply, :pong, s}
+
+    def handle_call(:start, _, s) do
+      owner = self()
+
+      worker =
+        spawn(fn ->
+          receive do
+            {:start, job, token} ->
+              Resources.bind(s.scope)
+
+              Resources.file_effect(fn ->
+                {:ok, observation} =
+                  ObservedRead.read(s.root, s.namespace, s.intent["request"]["request"])
+
+                reply = GenServer.call(owner, {:observation, job, token, observation}, 5000)
+                send(s.test, {:worker_reply, reply})
+              end)
+
+              send(s.test, :worker_finished)
+              receive do: (:stop -> :ok)
+          end
+        end)
+
+      :ok = Resources.attach(s.scope, worker)
+      job = make_ref()
+
+      {:ok, admission, token} =
+        ObservationAdmission.start(
+          job,
+          worker,
+          s.intent,
+          s.identity,
+          s.identity["artifact_sha256"],
+          s.writer
+        )
+
+      send(s.test, {:fixture_token, job, token})
+      send(worker, {:start, job, token})
+      {:reply, :ok, Map.merge(s, %{worker: worker, admission: admission, job: job})}
+    end
+
+    def handle_call({:observation, _, _, _}, _, %{pending: pending} = s) when not is_nil(pending),
+      do: {:reply, {:error, :refused}, s}
+
+    def handle_call({:observation, job, token, observation}, from = {caller, _}, s) do
+      case ObservationAsync.begin(s.admission, caller, job, token, observation, s.timeout) do
+        {:ok, pending} ->
+          {:noreply, Map.merge(s, %{pending: pending, from: from, admission: pending.admission})}
+
+        _ ->
+          {:reply, {:error, :refused}, put_in(s, [:admission, :phase], :failed)}
+      end
+    end
+
+    def handle_call(:close, _, s) do
+      :ok = Resources.finish(s.scope)
+      send(s.worker, :stop)
+      :ok = Resources.close(s.scope)
+      :ok = Journal.Writer.close(s.writer)
+      {:stop, :normal, {:ok, s.id}, s}
+    end
+
+    @impl true
+    def handle_info(message, %{pending: pending} = s) when not is_nil(pending) do
+      case ObservationAsync.handle(pending, message) do
+        {:pending, next} ->
+          if pending.phase != :append and next.phase == :append, do: send(s.test, :writer_queued)
+          {:noreply, %{s | pending: next}}
+
+        {:finished, result, next} ->
+          GenServer.reply(s.from, {:error, result})
+          {:noreply, Map.merge(s, %{pending: nil, terminal: next})}
+      end
+    end
+
+    def handle_info(_, s), do: {:noreply, s}
+  end
+
+  defp setup_intent(namespace) do
+    identity = %{
+      "instance" => "synthetic",
+      "artifact_sha256" => JSON.sha256("reviewed-synthetic")
+    }
+
+    request = %{"op" => "collection.call", "request" => %{"op" => "get", "key" => "note.absent"}}
+
+    pin = %{
+      "version" => 1,
+      "session_id" => Usage.id(),
+      "project_id" => JSON.sha256("project"),
+      "worktree_id" => JSON.sha256("worktree"),
+      "binding_sha256" => JSON.sha256("binding"),
+      "epoch" => 1,
+      "policy_sha256" => JSON.sha256("policy"),
+      "identity_sha256" => JSON.digest([identity]),
+      "namespace" => namespace,
+      "routes_sha256" => JSON.sha256("routes"),
+      "source_sha256" => JSON.sha256("source")
+    }
+
+    binding = %{
+      "kind" => "collection",
+      "version" => 1,
+      "namespace" => namespace,
+      "pin" => pin,
+      "inner_op" => "get",
+      "request_sha256" => JSON.digest([request["request"]])
+    }
+
+    intent = %{
+      "type" => "extension_action_intent",
+      "version" => 2,
+      "parent_invocation_id" => Usage.id(),
+      "operation_id" => Usage.id(),
+      "step" => 1,
+      "identity_sha256" => JSON.digest([identity]),
+      "namespace" => namespace,
+      "context_sha256" => nil,
+      "service" => nil,
+      "request" => request,
+      "request_sha256" => JSON.digest([request]),
+      "approval" => "not_required",
+      "effect_binding" => binding
+    }
+
+    {intent, identity}
+  end
+
+  defp owner(timeout) do
+    base = Path.join(System.tmp_dir!(), "ipse-observation-async-" <> Usage.id())
+    File.mkdir_p!(base)
+    File.chmod!(base, 0o700)
+    ExUnit.Callbacks.on_exit(fn -> File.rm_rf!(base) end)
+    dir = Path.join(base, "journal")
+    File.mkdir_p!(dir)
+    namespace = JSON.sha256("namespace")
+    {intent, identity} = setup_intent(namespace)
+
+    {:ok, owner} =
+      Owner.start(%{
+        dir: dir,
+        root: Path.join(base, "collections"),
+        namespace: namespace,
+        intent: intent,
+        identity: identity,
+        timeout: timeout,
+        test: self()
+      })
+
+    {owner, dir, intent}
+  end
+
+  test "owner remains responsive while the real journal writer is stalled" do
+    {owner, dir, intent} = owner(4000)
+    writer = GenServer.call(owner, :writer)
+    :ok = :sys.suspend(writer)
+
+    try do
+      assert :ok = GenServer.call(owner, :start)
+      assert_receive {:fixture_token, job, token}, 5000
+      assert_receive :writer_queued, 5000
+      assert :pong = GenServer.call(owner, :ping, 500)
+      assert {:error, :refused} = GenServer.call(owner, {:observation, job, token, %{}}, 500)
+      refute_receive {:worker_reply, _}, 100
+    after
+      :ok = :sys.resume(writer)
+    end
+
+    assert_receive {:worker_reply, {:error, :recorded_not_exposed}}, 5000
+    assert_receive :worker_finished, 5000
+    assert {:ok, id} = GenServer.call(owner, :close)
+    assert {:ok, [_header, envelope]} = Journal.load(dir, id)
+    assert {:ok, _} = ObservationAsync.replay(intent, envelope)
