+    writer = GenServer.call(owner, :writer)
+    :ok = :sys.suspend(writer)
+
+    try do
+      assert :ok = GenServer.call(owner, :start)
+      assert_receive {:fixture_token, _, _}, 5000
+      assert_receive :writer_queued, 5000
+      assert_receive {:worker_reply, {:error, :unknown}}, 5000
+      assert_receive :worker_finished, 5000
+      assert :pong = GenServer.call(owner, :ping, 500)
+    after
+      :ok = :sys.resume(writer)
+    end
+
+    assert {:ok, id} = GenServer.call(owner, :close)
+    assert {:ok, [_header, envelope]} = Journal.load(dir, id)
+    # Structural validity alone cannot overrule the owner's unknown outcome.
+    assert {:ok, _} = ObservationAsync.replay(intent, envelope)
+  end
