+defmodule Ipse.Session.ObservationAsync do
+  @moduledoc false
+  alias Ipse.{JSON, Session.Resources}
+  alias Ipse.Session.ObservationReceipt
+  alias Ipse.Extension.Actions
+
+  # Unwired prototype. Only a Session owning `admission` may call this, using
+  # the actual GenServer.from pid. It emits one content-private JSONL envelope
+  # through the existing owner-authorized Writer without waiting in the owner.
+  # This does not authenticate the reviewed artifact or current policy/root,
+  # enforce later-use barriers, or guarantee cancellation of queued writes.
+  def begin(
+        %{owner: owner, worker: worker, job: job, token: token, phase: :pending} = admission,
+        caller,
+        job,
+        token,
+        observation,
+        timeout
+      )
+      when owner == self() and is_pid(caller) and caller != worker and is_integer(timeout) and
+             timeout in 1..120_000 do
+    with [{scope, _}] <- Registry.lookup(Ipse.Registry, {Resources, worker}),
+         true <- is_pid(scope) do
+      nonce = make_ref()
+      timer = Process.send_after(self(), {:observation_deadline, job, nonce}, timeout)
+      request = :gen_server.send_request(scope, {:authorized_effect, worker, caller})
+
+      {:ok,
+       %{
+         owner: owner,
+         admission: %{admission | phase: :async_pending, token: nil},
+         caller: caller,
+         observation: observation,
+         phase: :authority,
+         request: request,
+         timer: timer,
+         deadline: System.monotonic_time(:millisecond) + timeout,
+         nonce: nonce,
+         submitted: false
+       }}
+    else
+      _ -> {:error, :observation_refused}
+    end
+  rescue
+    _ -> {:error, :observation_refused}
+  catch
+    _, _ -> {:error, :observation_refused}
+  end
+
+  def begin(_, _, _, _, _, _), do: {:error, :observation_refused}
+
+  # Session routes its own mailbox through this; no event or value is returned.
+  def handle(%{owner: owner} = state, message) when owner == self() do
+    cond do
+      message == {:observation_deadline, state.admission.job, state.nonce} ->
+        finish(state, :unknown)
+
+      System.monotonic_time(:millisecond) >= state.deadline ->
+        finish(state, :unknown)
+
+      true ->
+        case :gen_server.check_response(message, state.request) do
+          {:reply, value} -> response(state, value)
+          {:error, _} -> finish(state, :unknown)
+          :no_reply -> {:pending, state}
+        end
+    end
+  rescue
+    _ -> finish(state, :unknown)
+  catch
+    _, _ -> finish(state, :unknown)
+  end
+
+  def handle(state, _), do: {:finished, :unknown, state}
+
+  # This checks one historical envelope only. It is not a complete journal
+  # validator; Session must derive the mandatory intents and reject omission,
+  # cancellation/reordering and later use without current authority.
+  def replay(intent, envelope) do
+    with true <-
+           is_map(envelope) and
+             Enum.sort(Map.keys(envelope)) == ~w(action intent_sha256 receipt type version),
+         true <-
+           envelope["type"] == "collection_observation_transaction" and envelope["version"] === 1,
+         true <- envelope["intent_sha256"] === JSON.digest([intent]),
+         true <- Actions.result_intent(envelope["action"]) === intent,
+         :ok <- ObservationReceipt.verify(envelope["action"], envelope["receipt"]) do
+      {:ok, envelope["receipt"]["dependency"]}
+    else
+      _ -> {:error, :observation_replay_refused}
+    end
+  rescue
+    _ -> {:error, :observation_replay_refused}
+  end
+
+  defp response(%{phase: :authority} = state, true) do
+    with true <- Process.alive?(state.caller) and Process.alive?(state.admission.worker),
+         {:ok, prepared} <-
+           ObservationReceipt.prepare(
+             state.admission.intent,
+             state.admission.identity,
+             state.observation
+           ),
+         {:ok, result} <-
+           Actions.result(state.admission.intent, %{"status" => "ok", "value" => prepared.value}),
+         {:ok, receipt} <-
+           ObservationReceipt.bind(
+             state.admission.intent,
+             state.admission.identity,
+             state.observation,
+             result
+           ),
+         envelope = %{
+           "type" => "collection_observation_transaction",
+           "version" => 1,
+           "intent_sha256" => JSON.digest([state.admission.intent]),
+           "action" => result,
+           "receipt" => receipt
+         },
+         true <- System.monotonic_time(:millisecond) < state.deadline do
+      request = :gen_server.send_request(state.admission.writer, {:append, :plain, envelope})
+      {:pending, %{state | phase: :append, request: request, observation: nil, submitted: true}}
+    else
+      _ -> finish(state, :unknown)
+    end
+  end
+
+  defp response(%{phase: :append} = state, :ok), do: finish(state, :recorded_not_exposed)
+  defp response(state, _), do: finish(state, :unknown)
+
+  defp finish(state, result) do
+    Process.cancel_timer(state.timer)
+    {:finished, result, %{state | phase: :terminal, observation: nil}}
+  end
+end
