     case withdraw(d, messages, :incomplete) do
       {:ok, _} -> {:ok, messages}
       error -> error
     end
   end
 
-  def project(%{status: :consumed, accepted_message: true} = d, messages) when is_list(messages),
-    do: withdraw(d, messages, :accepted)
+  defp project_one(%{status: :consumed, accepted_message: true} = d, messages)
+       when is_list(messages),
+       do: withdraw(d, messages, :accepted)
 
-  def project(%{status: :consumed, accepted_message: false} = d, messages)
-      when is_list(messages) do
+  defp project_one(%{status: :consumed, accepted_message: false} = d, messages)
