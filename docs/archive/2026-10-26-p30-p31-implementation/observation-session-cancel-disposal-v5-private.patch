+      refute_receive {:DOWN, ^guard_ref, :process, ^guard, _}, 5_000
+      assert Process.alive?(effect) and Process.alive?(guard)
+      assert Port.info(external_port, :os_pid) == {:os_pid, os_pid}
+      assert {:error, _} = Ipse.Runner.lock(Path.join(c.dir, id <> ".lock"))
+      refute File.exists?(marker)
+      send(effect, :release)
+      assert_receive :late_private_effect_completed, 5_000
+      refute Port.info(external_port)
+      assert_receive {:DOWN, ^guard_ref, :process, ^guard, _}, 10_000
+      assert_receive {:DOWN, ^owner_ref, :process, ^pid, :normal}, 5_000
+      assert {:ok, port} = Ipse.Runner.lock(Path.join(c.dir, id <> ".lock"))
+      assert :ok = Ipse.Runner.unlock(port)
+      assert File.read!(marker) == "effect completed"
+      {:ok, events} = Journal.load(c.dir, id)
+      assert {:error, _} = Ipse.Session.ObservationReplay.check(events, id)
+    after
+      if Process.alive?(writer), do: :sys.resume(writer)
+      if Process.alive?(effect), do: Process.exit(effect, :kill)
+      if Process.alive?(pid), do: Process.exit(pid, :kill)
+      :telemetry.detach(handler)
+    end
+  end
