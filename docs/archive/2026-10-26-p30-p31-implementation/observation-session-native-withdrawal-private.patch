+  defp exercise_private_withdrawal(c, late?) do
+    identity = hd(c.config.extensions).identity
+
+    config = %{
+      execution_mode: :planning,
+      fixture_export: "inspect",
+      fixture_mode: "read",
+      private_observation_probe: true,
+      private_observation_guard: %{
+        "artifact_sha256" => identity["artifact_sha256"],
+        "identity_sha256" => JSON.digest([identity])
+      }
+    }
+
+    pid = start(c, config)
+    id = Session.info(pid).id
+    writer = :sys.get_state(pid).journal_writer
+    handler = {__MODULE__, make_ref()}
+
+    :ok =
+      :telemetry.attach_many(
+        handler,
+        [
+          [:ipse, :private_observation, :before_append],
+          [:ipse, :private_observation, :before_withdrawal]
+        ],
+        fn event, _, _, {test, writer, late?} ->
+          case event do
+            [:ipse, :private_observation, :before_append] ->
+              :ok = :sys.suspend(writer)
+              send(test, :writer_stalled_for_native_recovery)
+
+            [:ipse, :private_observation, :before_withdrawal] when late? ->
+              :ok = :sys.suspend(writer)
+
+              spawn(fn ->
+                Process.sleep(6_000)
+                if Process.alive?(writer), do: :sys.resume(writer)
+                send(test, :late_withdrawal_writer_resumed)
+              end)
+
+            _ ->
+              :ok
+          end
+        end,
+        {self(), writer, late?}
+      )
+
+    try do
+      assert :ok = Session.prompt(pid, "Synthetic café observation")
+      assert_receive :writer_stalled_for_native_recovery, 15_000
+      assert {:error, :cleanup_unconfirmed} = Session.cancel(pid)
+      assert %{journal: :pending} = GenServer.call(pid, :private_recovery_status)
+      assert {:error, :cleanup_unconfirmed} = GenServer.call(pid, :private_recovery_start)
+      :ok = :sys.resume(writer)
+
+      assert {:error, :journal_owner_or_record_invalid} =
+               GenServer.call(writer, :private_test_drain)
+
+      assert %{journal: :recorded, cleanup: :scope_closed} = private_recovery_ready(pid, 300)
+
+      assert {:error, :cleanup_unconfirmed} =
+               Task.async(fn -> GenServer.call(pid, :private_recovery_start) end) |> Task.await()
+
+      assert {:ok, lease} = GenServer.call(pid, :private_recovery_start)
+      assert {:ok, text, witness} = Ipse.Session.Input.await(lease, 10_000)
+      assert String.starts_with?(text, "withdraw ")
+
+      assert {:error, :cleanup_unconfirmed} =
+               Task.async(fn ->
+                 GenServer.call(pid, {:private_recovery_confirm, text, witness})
+               end)
+               |> Task.await()
+
+      confirmation = GenServer.call(pid, {:private_recovery_confirm, text, witness}, 10_000)
+
+      if late? do
+        assert {:error, :observation_unknown} = confirmation
+        assert_receive :late_withdrawal_writer_resumed, 3_000
+
+        assert {:error, :journal_owner_or_record_invalid} =
+                 GenServer.call(writer, :private_test_drain)
+      else
+        assert :ok = confirmation
+      end
+
+      assert {:error, :cleanup_unconfirmed} =
+               GenServer.call(pid, {:private_recovery_confirm, text, witness})
+
+      assert {:error, :cleanup_unconfirmed} = Session.close_confirmed(pid)
+
+      before = File.read!(c.trace)
+      {:ok, events} = Journal.load(c.dir, id)
+      assert :ok = Ipse.Session.ObservationReplay.check(events, id)
+      assert {:ok, saved} = Session.Saved.restore(events, id)
+      assert saved.extension_state.unknown
+      refute inspect(saved.messages) =~ "floor_anchor"
+      resumed = start(c, Map.put(config, :provider_module, PrivateRecoveryModel), id)
+      assert File.read!(c.trace) == before
+      assert {:ok, page} = Session.sources(resumed, "source.list", %{"limit" => 32})
+      refute inspect(page) =~ "floor_anchor"
+
+      for row <- page["sources"] do
+        assert {:ok, source} =
+                 Session.sources(resumed, "source.read", %{"handle" => row["read_handle"]})
+
+        refute inspect(source) =~ "floor_anchor"
+      end
+
+      assert :ok = Session.prompt(resumed, "Synthetic continuation after withdrawal")
+      assert_receive {:ipse, ^resumed, {:done, :ok}}, 5_000
+      assert File.read!(c.trace) == before
+      assert :ok = Session.close_confirmed(resumed)
+      {:ok, continued} = Journal.load(c.dir, id)
+      assert :ok = Ipse.Session.ObservationReplay.check(continued, id)
+      assert {:ok, _} = Session.Saved.restore(continued, id)
+    after
+      if Process.alive?(writer), do: :sys.resume(writer)
+      :telemetry.detach(handler)
+    end
+  end
