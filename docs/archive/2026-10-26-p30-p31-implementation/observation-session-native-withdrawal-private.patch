+  defp private_recovery_status(pid, expected, attempts) when attempts > 0 do
+    case GenServer.call(pid, :private_recovery_status) do
+      %{journal: ^expected} = status ->
+        status
+
+      _ ->
+        Process.sleep(10)
+        private_recovery_status(pid, expected, attempts - 1)
+    end
+  end
+
+  defp private_recovery_status(_, _, 0), do: :timeout
+
+  defp private_recovery_ready(pid, attempts) when attempts > 0 do
+    case GenServer.call(pid, :private_recovery_status) do
+      %{journal: :recorded, cleanup: :scope_closed} = status ->
+        status
+
+      _ ->
+        Process.sleep(10)
+        private_recovery_ready(pid, attempts - 1)
+    end
+  end
+
+  defp private_recovery_ready(_, 0), do: :timeout
