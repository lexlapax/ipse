+  def day_declaration!(ref) do
+    assert ref["sha256"] == @day_declaration_sha256
+    verify!(ref)
+    assert {:ok, declaration} = JSON.decode_unique(File.read!(ref["path"]))
+    assert declaration["version"] == 2
+    assert declaration["kind"] == "provisional_native_day_declaration"
+    assert declaration["reviewed"] == true
+    assert declaration["intake_ratified"] == false and declaration["qualification"] == false
+    declaration
+  end
+
+  def verify_day_plan!(ref, fixture, schedule) do
+    declaration = day_declaration!(ref)
+    assert fixture["day_declaration"] === ref
+    assert fixture["intake_ratified"] == false and fixture["qualification"] == false
+    assert fixture["ordinary_intake"] == declaration["fresh_ordinary_records"]
+    assert fixture["additional_mixed_changes"] == declaration["additional_changes_day"]
+    assert fixture["reasons"] === declaration["first_day_reasons"]
+    assert length(fixture["segments"]) == declaration["day_effects"]
+    assert Enum.all?(fixture["segments"], &(length(&1["actions"]) == 1))
+    actions = Enum.flat_map(fixture["segments"], & &1["actions"])
+    assert JSON.digest([actions]) == declaration["first_day_actions_sha256"]
+    assert Enum.frequencies_by(actions, & &1["reason"]) === declaration["first_day_reasons"]
+    assert Enum.frequencies_by(actions, & &1["op"]) === declaration["day_effects_by_operation"]
+    shape = fn rows -> Enum.map(rows, &Map.delete(&1, "process_offset_day")) end
+    assert shape.(schedule) === shape.(declaration["schedule"])
+    assert Enum.sum(Enum.map(schedule, & &1["turns"])) == declaration["day_turns"]
+    :ok
+  end
