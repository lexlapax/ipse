--- a/test/dev/knowledge/native_notes_retained_test.exs
+++ b/test/dev/knowledge/native_notes_retained_test.exs
@@ -5,6 +5,82 @@ defmodule Ipse.Development.NativeNotesRetainedTest do
   alias Ipse.Development.NativeNotesRetained, as: Retained
   @day 86_400_000
 
+  test "the exact provisional declaration pins ordered effects and all forty turns" do
+    Code.require_file("../../../dev/knowledge/native_notes_seed.ex", __DIR__)
+    Code.require_file("../../../dev/knowledge/native_notes_workload.ex", __DIR__)
+    Code.require_file("../../../dev/knowledge/native_notes_integrated_full.ex", __DIR__)
+    ref = Retained.default_day_declaration!()
+    plan = Ipse.Development.NativeNotesWorkload.calendar(20)
+    day = hd(plan["days"])
+    segments = Ipse.Development.NativeNotesWorkload.segments(plan, 1) |> Enum.take(57)
+
+    fixture = %{
+      "day_declaration" => ref,
+      "intake_ratified" => false,
+      "qualification" => false,
+      "ordinary_intake" => 20,
+      "additional_mixed_changes" => 27,
+      "reasons" => Enum.frequencies_by(day["actions"], & &1["reason"]),
+      "segments" => segments
+    }
+
+    schedule = Ipse.Development.NativeNotesIntegratedFull.full_schedule(21, 57)
+    assert :ok = Retained.verify_day_plan!(ref, fixture, schedule)
+
+    directory =
+      Path.join(System.tmp_dir!(), "day-declaration-#{System.unique_integer([:positive])}")
+
+    File.mkdir!(directory)
+    on_exit(fn -> File.rm_rf!(directory) end)
+    changed = Path.join(directory, "declaration.json")
+    bytes = File.read!(ref["path"]) |> String.replace("\"day_turns\": 40", "\"day_turns\": 39")
+    File.write!(changed, bytes)
+    changed_ref = Retained.fingerprint(changed)
+    assert_raise ExUnit.AssertionError, fn -> Retained.day_declaration!(changed_ref) end
+
+    assert_raise ExUnit.AssertionError, fn ->
+      Retained.day_declaration!(%{ref | "path" => changed})
+    end
+
+    # Preserve all counts while changing a target: aggregate-only checks must not pass.
+    changed_segments =
+      List.update_at(segments, 20, fn segment ->
+        update_in(segment["actions"], fn [action] -> [Map.put(action, "target", "seed/other")] end)
+      end)
+
+    assert_raise ExUnit.AssertionError, fn ->
+      Retained.verify_day_plan!(ref, %{fixture | "segments" => changed_segments}, schedule)
+    end
+
+    assert_raise ExUnit.AssertionError, fn ->
+      Retained.verify_day_plan!(
+        ref,
+        fixture,
+        List.update_at(schedule, 0, &Map.put(&1, "turns", 9))
+      )
+    end
+  end
+
+  test "an attachment missing its declaration refuses before any retained-state read" do
+    directory =
+      Path.join(System.tmp_dir!(), "missing-declaration-#{System.unique_integer([:positive])}")
+
+    File.mkdir!(directory)
+    on_exit(fn -> File.rm_rf!(directory) end)
+    path = Path.join(directory, "attachment.json")
+
+    bytes =
+      Jason.encode!(%{
+        "version" => 1,
+        "kind" => "retained_native_day_attachment",
+        "root" => "/dev/shm/ipse-native-seed-recall-d739-20261103-01"
+      })
+
+    File.write!(path, bytes)
+    assert_raise KeyError, fn -> Retained.load!(path, Ipse.JSON.sha256(bytes)) end
+    assert File.ls!(directory) == ["attachment.json"]
+  end
+
   test "only the reviewed epoch and policy replacement can differ" do
     original = %{
       "epoch" => 1,
