+      {:ok,
+       [
+         sequence,
+         epoch,
+         Base.encode16(request, case: :lower),
+         created,
+         if(status == 0, do: "settled", else: "reconciled_overrun"),
+         actual,
+         Base.encode16(receipt, case: :lower)
+       ]}
+    else
+      _ -> @error
+    end
+  end
+
+  defp decode_compact(_), do: @error
