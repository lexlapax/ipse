+      case decode_compact(row) do
+        {:ok, decoded} -> {:cont, {:ok, Map.put(rows, id, decoded)}}
+        _ -> {:halt, @error}
+      end
+    end)
+    |> case do
+      {:ok, rows} -> {:ok, state |> Map.put("version", 2) |> Map.put("compacted", rows)}
+      _ -> @error
+    end
